@page "{id:int}"
@model KasirSembako.Pages.Transaksi.PrintModel
@{
    ViewData["Title"] = "Print Struk";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Struk Belanja</title>
    <style>
        body { font-family: monospace; width: 300px; margin: 0 auto; padding: 10px; }
        h3 { text-align: center; }
        .line { border-top: 1px dashed #000; margin: 5px 0; }
        .row { display: flex; justify-content: space-between; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <h3>TOKO SEMBAKO</h3>
    <p style="text-align:center">Jl. pwk No. 11</p>
    <div class="line"></div>
    <p>Tanggal: @Model.Transaksi.Tanggal.ToString("dd/MM/yyyy HH:mm")</p>
    <p>Pelanggan: @Model.Transaksi.NamaPelanggan</p>
    <div class="line"></div>

    @foreach (var item in Model.Transaksi.Details)
    {
        <div class="row">
            <span>@item.Produk?.Nama</span>
        </div>
        <div class="row">
            <span>@item.Jumlah x Rp @item.HargaSatuan.ToString("N0")</span>
            <span>Rp @item.Subtotal.ToString("N0")</span>
        </div>
    }

    <div class="line"></div>
    <div class="row"><span><strong>Total</strong></span><span><strong>Rp @Model.Transaksi.TotalHarga.ToString("N0")</strong></span></div>
    <div class="row"><span>Bayar</span><span>Rp @Model.Transaksi.Bayar.ToString("N0")</span></div>
    <div class="row"><span>Kembalian</span><span>Rp @Model.Transaksi.Kembalian.ToString("N0")</span></div>
    <div class="line"></div>
    <p style="text-align:center">Terima Kasih!</p>

    <div class="no-print" style="margin-top:20px">
        <button onclick="window.print()" style="width:100%">🖨️ Print Struk</button>
        <a href="/Transaksi"><button style="width:100%; margin-top:5px">Kembali</button></a>
    </div>

    <script>window.onload = function() { window.print(); }</script>
</body>
</html>