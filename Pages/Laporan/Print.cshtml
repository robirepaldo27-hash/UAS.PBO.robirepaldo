@page
@model KasirSembako.Pages.Laporan.PrintModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Laporan Transaksi</title>
    <style>
        body { font-family: Arial; padding: 20px; }
        h3 { text-align: center; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #000; padding: 5px; }
        th { background: #333; color: white; }
        .total { font-weight: bold; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <h3>LAPORAN TRANSAKSI TOKO SEMBAKO</h3>
    <p>Periode: @Model.Dari.ToString("dd/MM/yyyy") - @Model.Sampai.ToString("dd/MM/yyyy")</p>
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Tanggal</th>
                <th>Pelanggan</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Transaksis.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@Model.Transaksis[i].Tanggal.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@Model.Transaksis[i].NamaPelanggan</td>
                    <td>Rp @Model.Transaksis[i].TotalHarga.ToString("N0")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total">
                <td colspan="3">Total Pendapatan</td>
                <td>Rp @Model.TotalPendapatan.ToString("N0")</td>
            </tr>
        </tfoot>
    </table>

    <div class="no-print" style="margin-top:20px">
        <button onclick="window.print()">🖨️ Print</button>
    </div>
    <script>window.onload = function() { window.print(); }</script>
</body>
</html>