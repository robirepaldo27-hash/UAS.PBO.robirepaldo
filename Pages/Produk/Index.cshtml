@page
@model KasirSembako.Pages.Produk.IndexModel
@{
    ViewData["Title"] = "Data Produk";
}

<div class="page-header">
    <h2>📦 Data Produk</h2>
    <a href="/Produk/Create" class="btn btn-primary">+ Tambah Produk</a>
</div>

<div class="table-wrapper">
    <table class="table">
        <thead>
            <tr>
                <th>No</th>
                <th>Nama Produk</th>
                <th>Satuan</th>
                <th>Harga Beli</th>
                <th>Harga Jual</th>
                <th>Stok</th>
                <th>Aksi</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Produks.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td><strong>@Model.Produks[i].Nama</strong></td>
                    <td>@Model.Produks[i].Satuan</td>
                    <td>Rp @Model.Produks[i].HargaBeli.ToString("N0")</td>
                    <td>Rp @Model.Produks[i].HargaJual.ToString("N0")</td>
                    <td><span class="badge-stok">@Model.Produks[i].Stok</span></td>
                    <td>
                        <a href="/Produk/Edit/@Model.Produks[i].Id" class="btn btn-warning btn-sm">✏️ Edit</a>
                        <a href="/Produk/Delete/@Model.Produks[i].Id" class="btn btn-danger btn-sm">🗑️ Hapus</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>