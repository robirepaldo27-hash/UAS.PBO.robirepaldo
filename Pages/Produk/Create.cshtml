@page
@model KasirSembako.Pages.Produk.CreateModel
@{
    ViewData["Title"] = "Tambah Produk";
}

<div class="page-header">
    <h2>➕ Tambah Produk</h2>
    <a href="/Produk" class="btn btn-secondary">← Kembali</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-wrapper">
            <form method="post">
                <div class="mb-3">
                    <label>Nama Produk</label>
                    <input asp-for="Produk.Nama" class="form-control" placeholder="contoh: Beras Premium" required />
                </div>
                <div class="mb-3">
                    <label>Satuan</label>
                    <input asp-for="Produk.Satuan" class="form-control" placeholder="kg, liter, pcs, dll" required />
                </div>
                <div class="mb-3">
                    <label>Harga Beli (Rp)</label>
                    <input asp-for="Produk.HargaBeli" class="form-control" type="number" placeholder="0" required />
                </div>
                <div class="mb-3">
                    <label>Harga Jual (Rp)</label>
                    <input asp-for="Produk.HargaJual" class="form-control" type="number" placeholder="0" required />
                </div>
                <div class="mb-3">
                    <label>Stok Awal</label>
                    <input asp-for="Produk.Stok" class="form-control" type="number" placeholder="0" required />
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">💾 Simpan</button>
                    <a href="/Produk" class="btn btn-secondary">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>