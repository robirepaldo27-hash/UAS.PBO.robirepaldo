@page "{id:int}"
@model KasirSembako.Pages.Produk.EditModel
@{
    ViewData["Title"] = "Edit Produk";
}

<div class="page-header">
    <h2>✏️ Edit Produk</h2>
    <a href="/Produk" class="btn btn-secondary">← Kembali</a>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-wrapper">
            <form method="post">
                <input type="hidden" asp-for="Produk.Id" />
                <div class="mb-3">
                    <label>Nama Produk</label>
                    <input asp-for="Produk.Nama" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label>Satuan</label>
                    <input asp-for="Produk.Satuan" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label>Harga Beli (Rp)</label>
                    <input asp-for="Produk.HargaBeli" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label>Harga Jual (Rp)</label>
                    <input asp-for="Produk.HargaJual" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label>Stok</label>
                    <input asp-for="Produk.Stok" class="form-control" type="number" required />
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning">💾 Update</button>
                    <a href="/Produk" class="btn btn-secondary">Batal</a>
                </div>
            </form>
        </div>
    </div>
</div>